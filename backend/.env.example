# .env.example
# Purpose: Template for environment variables.
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=AI Communication POC
DEBUG=true

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ai_comm:ai_comm_dev@localhost:5432/ai_comm_db

# ── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / LLM (OpenAI-compatible) ─────────────────────────────────────────────
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
